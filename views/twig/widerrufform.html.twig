{% capture append="oxidBlock_content"  %}
    {% set oldBS=oView.isLegacyBS()  %}

    {% set template_title=oView.getTitle()  %}
    <h1 class="page-header">{{ template_title  }}</h1>
    <form class="form-horizontal" action="{{ oViewConf.getSslSelfLink() }}" method="post" role="form" id="wdf">
        <div class="hidden">
            {{ oViewConf.getHiddenSid()|raw }}
            <input type="hidden" name="fnc" value=""/>
			<input type="hidden" name="cl" value="{{ oViewConf.getActiveClassName() }}">
            <input type="hidden" name="user" value="{{ oxcmp_user.oxuser__oxusername.value  }}"/>
        </div>

        <div class="row justify-content-md-center">

            {% if submitSuccess  %}
                <div class="col-12 col-md-8 {% if oldBS  %}col-md-push-2{% endif %}">
                    <div class="alert alert-success">{{ translate({ ident: "WITHDRAWAL_SUCCESS"  }) }}</div>
                </div>
            {% else  %}
                <div class="col-12 col-md-8 {% if oldBS  %}col-md-push-2{% endif %}">
                    <div class="alert alert-info">Bitte füllen Sie sorgfältig dieses Fomular aus. Im Anschluß erhalten Sie eine Email mit Ihren Angaben und Instruktionen für den Rückversand der Ware.<br>
					{% if oxcmp_user and oView.getUserOrders()   %}
					
					{% else   %}
						<strong>Hinweis: Wenn Sie sich vorher einloggen, wird das Formular für Sie gefüllt und Sie können bequem eine Bestellung wählen</strong>
					{% endif %}
					
                    </div>

                    <div class="form-group">
                        <label for="wdfname" class="{% if oldBS  %}control{% else  %}col-form{% endif %}-label col-sm-5 col-md-4 text-right">{{ translate({ ident: "FIRST_NAME"  }) }}
                            , {{ translate({ ident: "LAST_NAME"  }) }} <b>*</b></label>
                        <div class="col-sm-7 col-md-8">
                            <input type="text" class="form-control" id="wdfname" name="wdf[name]" required autocomplete="shipping name"
                                   value="{% if smarty.post.wdf.name  %}
								   {{ smarty.post.wdf.name  }}
								   {% elseif oxcmp_user  %}
								   {{ oxcmp_user.oxuser__oxfname.value }}
								   {{ oxcmp_user.oxuser__oxlname.value }}
								   {% endif %}">
                        </div>
                    </div> {# NAME #}
                    <div class="form-group">
                        <label for="wdfemail" class="{% if oldBS  %}control{% else  %}col-form{% endif %}-label col-sm-5 col-md-4 text-right">{{ translate({ ident: "STREET_AND_STREETNO"  }) }} <b>*</b></label>
                        <div class="col-sm-7 col-md-8">
                            <input type="text" class="form-control" id="wdfstreet" name="wdf[street]" required autocomplete="shipping street-address"
                                   value="{% if smarty.post.wdf.street  %}
								   {{ smarty.post.wdf.street  }}
								   {% elseif oxcmp_user  %}
								   {{ oxcmp_user.oxuser__oxstreet.value  }}
								   {{ oxcmp_user.oxuser__oxstreetnr.value  }}
								   {% endif %}">
                        </div>
                    </div> {# STRASSE #}
                    <div class="form-group">
                        <label for="wdfemail" class="{% if oldBS  %}control{% else  %}col-form{% endif %}-label col-sm-5 col-md-4 text-right">{{ translate({ ident: "POSTAL_CODE_AND_CITY"  }) }} <b>*</b></label>
                        <div class="col-sm-7 col-md-8">
                            <input type="text" class="form-control" id="wdfzipcity" name="wdf[zipcity]" required autocomplete="shipping postal-code address-level2"
                                   value="{% if smarty.post.wdf.zipcity  %}
								   {{ smarty.post.wdf.zipcity  }}
								   {% elseif oxcmp_user  %}
								   {{ oxcmp_user.oxuser__oxzip.value  }}
								   {{ oxcmp_user.oxuser__oxcity.value  }}
								   {% endif %}">
                        </div>
                    </div> {# PLZ ORT #}
                    <div class="form-group">
                        <label class="{% if oldBS  %}control{% else  %}col-form{% endif %}-label col-sm-5 col-md-4 text-right">{{ translate({ ident: "COUNTRY"  }) }} <b>*</b></label>
                        <div class="col-sm-7 col-md-8">
                            {% if oViewConf.getCountryList()|length == 1  %}
                                {% for _country in oViewConf.getCountryList()  %}
                                <input type="text" class="form-control" id="wdfcountry" name="wdf[country]" required value="{{ _country.oxcountry__oxtitle.value  }}" readonly autocomplete="shipping country-name">
                                {% endfor %}
                            {% else  %}
                                <select name="wdf[country]" class="{% if oldBS  %}form-control{% else  %}custom-select{% endif %}" required>
                                    <option>Wählen Sie Ihr Land</option>
                                    {% for _country in oViewConf.getCountryList() %}
                                        <option id="wdfcountry_{{ _country.oxcountry__oxid.value  }}" value="{{ _country.oxcountry__oxtitle.value  }}"
                                                {% if smarty.post.wdf.country == _country.oxcountry__oxtitle.value or oxcmp_user.oxuser__oxcountryid.value == _country.oxcountry__oxid.value   %}
												selected
												{% endif %}>
                                            {{ _country.oxcountry__oxtitle.value  }}
                                        </option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </div>
                    </div> {# Land #}
                    <div class="form-group">
                        <label for="wdfemail" class="{% if oldBS  %}control{% else  %}col-form{% endif %}-label col-sm-5 col-md-4 text-right">{{ translate({ ident: "EMAIL_ADDRESS"  }) }} <b>*</b></label>
                        <div class="col-sm-7 col-md-8">
                            <input type="email" class="form-control" id="wdfemail" name="wdf[email]" required autocomplete="email"
                                   value="{{ smarty.post.wdf.email|default(oxcmp_user.oxuser__oxusername.value)  }}">
                        </div>
                    </div> {# Email #}
                    <div class="form-group">
                        <label for="wdforder" class="{% if oldBS  %}control{% else  %}col-form{% endif %}-label col-sm-5 col-md-4 text-right">
                            {{ translate({ ident: "PAGE_TITLE_ORDER"  }) }}
                            {% if not oView.getUserOrders()  %}
								{{ translate({ ident: "NUMBER_2"  }) }} & {{ translate({ ident: "DATE"  }) }}
							{% endif %}
							<b>*</b>
                        </label>
                        <div class="col-sm-7 col-md-8">
                            {% if not oView.getUserOrders()  %}
                                <input type="text" class="form-control" id="wdforder" name="wdf[order]" required autocomplete="off" value="{{ smarty.post.wdf.order  }}">
                            {% else  %}
                                <select name="wdf[oxorderid]" id="wdforder" class="form-control" required>
                                    <option value="">- {{ translate({ ident: "PLEASE_CHOOSE"  }) }} -</option>
                                    {% for _order in oView.getUserOrders() %}
                                        <option value="{{ _order.oxorder__oxid.value  }}" {% if smarty.post.wdf.oxorderid == _order.oxorder__oxid.value  %}selected{% endif %}>
                                            Bestellung Nr.{{ _order.oxorder__oxordernr.value  }} vom {{ _order.oxorder__oxorderdate.value  }}
                                        </option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </div>
                    </div> {# Bestellung #}

                </div>
                <div class="col-12 col-md-10 pt-4 {% if oldBS  %}col-md-push-1{% endif %}">
                    {% if oxcmp_user and oView.getUserOrders() and not smarty.post.wdf.oxorderid   %}
                        {# angemeldeter benutzer + hat Bestellungen + noch keine Bestellung ausgewählt#}
                        <div class="alert alert-info text-center" role="alert">Wählen Sie Ihre Bestellung aus der Liste</div>
                    {% elseif oxcmp_user and oView.getUserOrders() and aOrderProducts and aOrderProducts|length >= 1   %}
                        {# angemeldeter benutzer + Bestellung ausgewählt +  Zeige Liste der Produkte aus der Bestellung #}

                        {% if aOrderProducts|length == 1  %}
                            <h3>Sie widerrufen den Kauf von folgendem Produkt:</h3>
                        {% else  %}
                            <h3>Welcher Produkte möchten Sie zurück geben?</h3>
                        {% endif %}

                        {% for _orderaarticle in aOrderProducts %}
                            <div class="form-group pt-2">
                                {# checkbox + name #}
                                <div class="checkbox col-12 col-md-5">
                                    <h4>
                                        {{ _orderaarticle.oxorderarticles__oxtitle.value  }}
                                        {{ _orderaarticle.oxorderarticles__oxselvariant.value  }}<br/>
                                        ( x{{ _orderaarticle.oxorderarticles__oxamount.value  }} für {{ _orderaarticle.oxorderarticles__oxbrutprice.value  }} )
                                    </h4>
                                    <input type="hidden" name="wdf[products][{{ _oxid  }}][title]"
                                           value="{{ _orderaarticle.oxorderarticles__oxtitle.value  }} {{ _orderaarticle.oxorderarticles__oxselvariant.value  }} ({{ _orderaarticle.oxorderarticles__oxartnum.value  }})">
                                    {% if aOrderProducts|length == 1   %}
                                        {# es gibt nur ein Produkt in der Bestellung #}
                                        <input type="hidden" name="wdf[products][{{ _oxid  }}][return]" value="1">
                                    {% else  %}
                                        {# zeige chekbox bei mehreren produkten #}
                                        <div class="checkbox">
                                            <input type="hidden" name="wdf[products][{{ _oxid  }}][return]" value="0">
                                            <label for="return_{{ _oxid  }}" class="btn btn-danger">
                                                <input type="checkbox" name="wdf[products][{{ _oxid  }}][return]" value="1" id="return_{{ _oxid  }}">
                                                Kauf widerrufen
                                            </label>
                                        </div>
                                    {% endif %}
                                </div>

                                {# eigener Grund #}
                                <div class="col-12 col-md-4">
                                <textarea name="wdf[products][{{ _oxid  }}][reasons][custom]" class="form-control" rows="{{ oView.getWithdrawalReasons()|default(4)  }}"
                                          placeholder="Warum möchten Sie dieses Produkt zurück geben?"></textarea>
                                </div>

								
                            </div>
                            <hr/>
                        {% endfor %}

                    {% else  %}
                        {# nicht angemeldet oder hat keine Bestellungen oder keine Produkte in der Bestellung #}
                        <h4>Den Kauf welcher Produkte möchten Sie widerrufen? <b>*</b></h4>
                        <div class="form-group">
                            <div class="col-12">
                                <input type="hidden" name="wdf[products][0][return]" value="1">
                                <textarea name="wdf[products][0][title]" class="form-control" rows="4" placeholder="Produktname (ggf. Artikelnummer), Menge und Preis"
                                          required>{{ smarty.post.wdf.products[0].title  }}</textarea>
                            </div>
                        </div>
                        {# Grund #}
                        <h4>Würden Sie uns auch den Grund für den Widerruf nennen?</h4>
                        <div class="form-group">
                            <div class="col-12 col-sm-8">
                            <textarea name="wdf[products][0][reasons][custom]" class="form-control" rows="{{ oView.getWithdrawalReasons()|default(4)  }}"
                                      placeholder="Was anderes? Hier können Sie einen anderen Grund angeben">{{ smarty.post.wdf.products[0].reasons.custom  }}</textarea>
                            </div>
                        </div>
                    {% endif %}

                    {% if ( oView.getUserOrders() and smarty.post.wdf.oxorderid ) or not oView.getUserOrders()   %}
                        <div class="row justify-content-md-center pt-5" id="submitError">
                            {% if submitError  %}
                                <div class="col-12 col-md-10 {% if oldBS  %}col-md-push-1{% endif %}">
                                    <div class="alert alert-danger">
                                        {{ translate({ ident: "WITHDRAWAL_ERROR_" ~ submitError, args: errorArgs   }) }}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                        <div class="form-group">
                            <div class="col-12 col-md-6 col-xl-7">
                                <p class="form-check">
                                    <input type="hidden" name="wdf[datenschutz]" value="0">
                                    <input class="form-check-input" type="checkbox" name="wdf[datenschutz]" value="1" id="datenschutzok" required
                                           {% if smarty.post.wdf.datenschutz == "1"  %}checked{% endif %}>
                                    <label class="form-check-label" for="datenschutzok">
                                        <b>*</b> Ich habe die <a href="https://oxid7.kleaner.eu/Datenschutz/" target="_blank"><u>Datenschutzbestimmungen</u></a> gelesen und
                                        akzeptiert.
                                    </label>
                                </p>
                                <p>
                                    <button id="submit" type="submit" class="btn btn-highlight" name="fnc" value="submitWithdrawal">Formular abschicken</button>
                                </p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </form>
<script><!--
        {% if oxcmp_user and oView.getUserOrders()   %}
        $("body").on("change", "select#wdforder", function ()
        {
            $.ajax({
                url: $("#wdf").attr('action'),
                type: 'POST',
                data: $("#wdf").serialize() + '&fnc=getOrderArticles&ajax=1',
                success: function (result)
                {
                    $("#content").html(result);
                }
            });
        });
        {% endif %}
        $("body").on("click", "#submit", function (e)
        {
            e.preventDefault();
            e.stopPropagation();
            if (!$("#wdfname").val() || !$("#wdfstreet").val() || !$("#wdfzipcity").val() || !$("#wdfemail").val() || !$("#wdforder").val() )
            {
                $("#submitError").html('<div class="col-12"><div class="alert alert-danger">Bitte füllen Sie alle Pflichtfelder aus.</div></div>');
                return false;
            }
            $.ajax({
                url: $("#wdf").attr('action'),
                type: 'POST',
                data: $("#wdf").serialize() + '&fnc=submitWithdrawal&ajax=1',
                success: function (result)
                {
                    //console.log(result);
                    $("#content").html(result);
                }
            });
        });
--></script>
   
{% endcapture  %}
{% if smarty.post.ajax == "1"  %}
    {# AJAX-Request: nur den Inhalt zurückgeben, ohne Layout drumherum #}
    {% for _block in oxidBlock_content  %}
        {{ _block  }}
    {% endfor %}
{% else  %}
    {# normaler Seitenaufruf: in das Shop-Layout einbetten #}
    {% include "layout/page.html.twig"  %}
{% endif %}

